{
  "name": "kth-style-mcp",
  "version": "1.0.0",
  "description": "MCP server for querying the KTH style package",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "node --test --import tsx test/**/*.test.ts",
    "start:http": "node dist/http.js",
    "notices": "node scripts/generate-notices.mjs"
  },
  "keywords": [],
  "author": "jrolofsson",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@kth/style": "^1.14.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
