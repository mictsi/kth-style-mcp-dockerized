# Full URL the app is published under. Everything is served under its path.
# PUBLIC_URL=https://example.kth.se/kth-style-mcp

# Path prefix only. Overrides the PUBLIC_URL path when set. "/" serves at root.
BASE_PATH=/kth-style-mcp

# Additional Host headers accepted (DNS rebinding protection), comma separated.
# ALLOWED_HOSTS=example.kth.se,localhost

# Number of reverse-proxy hops in front of the container.
TRUST_PROXY=0

# Host side of the published port.
BIND_ADDRESS=127.0.0.1
HOST_PORT=8888

# Serve the landing page and sample site under BASE_PATH alongside /mcp.
SERVE_SITE=true
